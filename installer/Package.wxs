<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Gaze 0.3 Alpha" Manufacturer="Gaze" Version="0.3.0" UpgradeCode="0A54FEC4-058D-4B97-BC88-4C79F9AA351A" Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Gaze is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes"><RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" /></Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 19041)" Message="Gaze requires 64-bit Windows 10 version 2004 or later." />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/bh808303/Gaze" />
    <Icon Id="GazeIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GazeIcon" />
    <StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="Gaze" /></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="GazeMenu" Name="Gaze">
        <Component Id="StartMenu" Guid="0B416236-EACB-49CE-B219-9A410A759B03">
          <Shortcut Id="GazeShortcut" Name="Gaze" Target="[INSTALLFOLDER]Gaze.App.exe" WorkingDirectory="INSTALLFOLDER" Icon="GazeIcon" />
          <RemoveFolder Id="RemoveGazeMenu" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Gaze" Name="Installed" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Gaze" Title="Gaze" Level="1"><ComponentGroupRef Id="Payload" /><ComponentRef Id="StartMenu" /></Feature>
  </Package>
</Wix>
