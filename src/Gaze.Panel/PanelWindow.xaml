<ui:FluentWindow x:Class="Gaze.Fluent.PanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Gaze" Width="332.35" Height="200" MinWidth="0" MinHeight="0" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" Style="{DynamicResource DefaultFluentWindowStyle}">
 <ui:FluentWindow.Template>
  <ControlTemplate TargetType="{x:Type ui:FluentWindow}">
   <AdornerDecorator><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></AdornerDecorator>
  </ControlTemplate>
 </ui:FluentWindow.Template>
 <ui:FluentWindow.Resources>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#667085"/><Setter Property="Margin" Value="0,5.88235,0,5.88235"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#344054"/><Setter Property="FontSize" Value="13"/></Style>
 </ui:FluentWindow.Resources>
 <Border x:Name="PanelFrame" Width="391" Height="235.2941176" Background="#F7F9FC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="0"><Border.LayoutTransform><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Border.LayoutTransform>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="0"/></Grid.RowDefinitions>
   <Grid>
    <Border Background="#12080B" CornerRadius="12,12,0,0"/>
    <Image Source="Assets/gaze-header.png" Stretch="Uniform" VerticalAlignment="Top" MouseLeftButtonDown="HeaderDrag" AutomationProperties.Name="Gaze — Into the abyss"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
     <ui:Button x:Name="RecordingsNavigation" ToolTip="Recordings" AutomationProperties.Name="Recordings" Click="RecordingsClick" Width="30" Height="30" Padding="0" Margin="0,0,5.88235,0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"><ui:SymbolIcon x:Name="RecordingsIcon" Symbol="Folder24" FontSize="15"/></ui:Button>
     <ui:Button x:Name="Gear" ToolTip="Settings" AutomationProperties.Name="Settings" Click="GearClick" Width="30" Height="30" Padding="0" Margin="0,0,5.88235,0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"><ui:SymbolIcon x:Name="GearIcon" Symbol="Settings24" FontSize="15"/></ui:Button>
     <ui:Button ToolTip="Quit Gaze" AutomationProperties.Name="Quit Gaze" Click="QuitClick" Width="30" Height="30" Padding="0" Margin="0,0,5.88235,0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"><ui:SymbolIcon Symbol="Power24" FontSize="15"/></ui:Button>
     <ui:Button ToolTip="Close panel" AutomationProperties.Name="Close panel" Click="DismissClick" Width="30" Height="30" Padding="0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"><ui:SymbolIcon Symbol="Dismiss24" FontSize="15"/></ui:Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="11.7647,5.88235,11.7647,0">
    <Grid x:Name="HomePage" VerticalAlignment="Top">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="5.88235">
      <StackPanel>
       <ui:Button x:Name="MainAction" Content="Arm recording" Appearance="Primary" Background="#B50F21" BorderBrush="#B50F21" Foreground="White" HorizontalAlignment="Stretch" Height="42" Click="MainClick"/>
       <DockPanel Margin="0,5.88235,0,0"><TextBlock x:Name="Status" Text="● Ready" Foreground="#15803D" FontWeight="SemiBold"/><TextBlock x:Name="Duration" Text="00:00:00" HorizontalAlignment="Right" Foreground="#667085"/></DockPanel>
       <ui:Button x:Name="CancelArm" Content="Cancel arming" Appearance="Transparent" HorizontalAlignment="Center" Margin="0,6,0,0" Click="CancelClick" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
     <Grid Grid.Row="1" Margin="0,5.88235,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CAPTURE" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ComboBox x:Name="Mode" Grid.Column="1" SelectionChanged="ModeChanged" Padding="10,7" AutomationProperties.Name="Capture mode"/></Grid>
    </Grid>
    <Grid x:Name="RecordingsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Orientation="Horizontal"><TextBlock Text="RECORDINGS" Style="{StaticResource Section}"/><TextBlock x:Name="FileCount" Text="(0)" Style="{StaticResource Section}" Margin="5.88235,5.88235,0,5.88235"/></StackPanel>
     <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="5.88235">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock x:Name="EmptyList" Text="No recordings in your save folder" Foreground="#98A2B3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <ListBox x:Name="Recordings" BorderThickness="0" Background="Transparent" SelectionChanged="SelectedRecordingChanged" MouseDoubleClick="RecordingDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="#344054"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="6"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
          <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="Bold"/></Trigger></Style.Triggers>
         </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="5,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Video24" Foreground="#667085" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Details}" Foreground="#98A2B3" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid><Border Grid.Row="1" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="0,5.88235,0,0" Margin="0,5.88235,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ui:Button x:Name="OpenFile" Content="Open" Click="OpenClick" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,5.88235,0"/>
     <ui:Button Grid.Column="1" Content="Open Folder" Click="FolderClick" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,5.88235,0"/>
     <ui:Button x:Name="CopyFile" Grid.Column="2" Content="Clipboard" Click="CopyClick" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,5.88235,0"/>
     <ui:Button x:Name="Cleanup" Grid.Column="3" Content="Clean-up" Click="CleanupClick" Foreground="#B42318" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0"/>
      </Grid></Border>
      </Grid>
     </Border>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Style="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="0,0,8,0">
     <StackPanel>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Heading" Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Start at sign-in" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/><ui:ToggleSwitch x:Name="StartAtSignIn" AutomationProperties.Name="Start at Windows sign-in"/></StackPanel></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CONTROLS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ui:TextBox x:Name="Shortcut" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="ShortcutKey" ToolTip="Shortcut: select this field and press your preferred keys" AutomationProperties.Name="Shortcut"/></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Copy to clipboard" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="AutoCopy" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Double Esc to stop" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="DoubleEscape" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,11.7647,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="RECORDINGS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ui:TextBox x:Name="Folder" Grid.Column="1" Margin="0,0,5.88235,0" AutomationProperties.Name="Save folder" ToolTip="Save folder"/><ui:Button Grid.Column="2" Content="Browse" Click="BrowseClick" Height="34" FontSize="12" Padding="4,0"/></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.ColumnSpan="2" Margin="0,0,60,0" Text="Claude Desktop Clipboard" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="SplitAt29Mb" HorizontalAlignment="Right" AutomationProperties.Name="Claude Desktop Clipboard"/></Grid>
      <TextBlock Text="Video: 29 MB parts. Transcribe: 20 images / 29 MB per batch." TextWrapping="Wrap" FontSize="12" Foreground="#667085" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Highlight clicks" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="Clicks" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Keyboard events in timeline" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="KeyboardTimeline" HorizontalAlignment="Right" AutomationProperties.Name="Keyboard events in timeline"/></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Record timeline metadata" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="RecordTimelineMetadata" HorizontalAlignment="Right" AutomationProperties.Name="Record timeline metadata"/></Grid>
      <Grid Margin="0,11.7647,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="COMPRESSION" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ComboBox x:Name="Compression" Grid.Column="1" Padding="10,7" AutomationProperties.Name="Compression"><ComboBoxItem Content="Original — sharper image"/><ComboBoxItem Content="Compact — smaller file"/></ComboBox></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="Fps" Grid.Column="1" Padding="4,7" FontSize="12" AutomationProperties.Name="Frames per second"/><TextBlock Grid.Column="2" Text="FPS" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/></Grid>
      <Grid Margin="0,0,0,5.88235"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Canvas" Grid.Column="1" Padding="4,7" FontSize="12" AutomationProperties.Name="Window canvas"><ComboBoxItem Content="Windows size"/><ComboBoxItem Content="Monitor size"/></ComboBox><TextBlock Grid.Column="2" Text="Canvas" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/></Grid>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Grid Grid.Row="2" Margin="11.7647,5.88235,11.7647,5.88235">
    <Grid x:Name="HomeFooter" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ui:Button Grid.Column="3" Content="Quit" Click="QuitClick" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="34" FontSize="12" Padding="4,0" Margin="0,0,5.88235,0"/>
    </Grid>
    <StackPanel x:Name="SettingsFooter" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"><ui:Button Content="Cancel" Click="CancelSettingsClick" Width="96" Height="34" FontSize="12" Padding="4,0" Margin="0,0,8,0"/><ui:Button Content="Save" Appearance="Primary" Click="SaveClick" Width="96" Height="34" FontSize="12" Padding="4,0"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</ui:FluentWindow>
