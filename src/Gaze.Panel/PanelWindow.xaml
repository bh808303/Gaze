<ui:FluentWindow x:Class="Gaze.Fluent.PanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Gaze" Width="460" Height="740" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" Style="{DynamicResource DefaultFluentWindowStyle}">
 <ui:FluentWindow.Template>
  <ControlTemplate TargetType="{x:Type ui:FluentWindow}">
   <AdornerDecorator><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></AdornerDecorator>
  </ControlTemplate>
 </ui:FluentWindow.Template>
 <ui:FluentWindow.Resources>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#667085"/><Setter Property="Margin" Value="0,20,0,10"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#344054"/><Setter Property="FontSize" Value="13"/></Style>
 </ui:FluentWindow.Resources>
 <Border Background="#F7F9FC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="24">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="103"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="100"/></Grid.RowDefinitions>
   <Grid>
    <Image Source="Assets/gaze-header.png" Stretch="Uniform" AutomationProperties.Name="Gaze — Into the abyss"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
     <ui:Button x:Name="Gear" ToolTip="Settings" AutomationProperties.Name="Settings" Click="GearClick" Width="30" Height="30" Padding="0" Margin="0,0,6,0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"><ui:SymbolIcon x:Name="GearIcon" Symbol="Settings24" FontSize="15"/></ui:Button>
     <ui:Button ToolTip="Close panel" AutomationProperties.Name="Close panel" Click="DismissClick" Width="30" Height="30" Padding="0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"><ui:SymbolIcon Symbol="Dismiss24" FontSize="15"/></ui:Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,12,0,0">
    <Grid x:Name="HomePage">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel>
       <DockPanel Margin="0,0,0,14"><TextBlock x:Name="Status" Text="● Ready" Foreground="#15803D" FontWeight="SemiBold"/><TextBlock x:Name="Duration" Text="00:00:00" HorizontalAlignment="Right" Foreground="#667085"/></DockPanel>
       <ui:Button x:Name="MainAction" Content="Arm recording" Appearance="Primary" Background="#B50F21" BorderBrush="#B50F21" Foreground="White" HorizontalAlignment="Stretch" Height="42" Click="MainClick"/>
       <ui:Button x:Name="CancelArm" Content="Cancel arming" Appearance="Transparent" HorizontalAlignment="Center" Margin="0,6,0,0" Click="CancelClick" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
     <StackPanel Grid.Row="1"><TextBlock Text="CAPTURE" Style="{StaticResource Section}"/><ComboBox x:Name="Mode" SelectionChanged="ModeChanged" Padding="10,7"/></StackPanel>
     <DockPanel Grid.Row="2"><TextBlock Text="RECORDINGS" Style="{StaticResource Section}"/><TextBlock x:Name="FileCount" Foreground="#98A2B3" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0"/></DockPanel>
     <Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="6">
      <Grid><TextBlock x:Name="EmptyList" Text="No recordings in your save folder" Foreground="#98A2B3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <ListBox x:Name="Recordings" BorderThickness="0" Background="Transparent" SelectionChanged="SelectedRecordingChanged" MouseDoubleClick="RecordingDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="#344054"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="6"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
          <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="Bold"/></Trigger></Style.Triggers>
         </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="5,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Video24" Foreground="#667085" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Details}" Foreground="#98A2B3" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Border>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Style="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="0,0,8,0">
     <StackPanel>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Heading" Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Start at sign-in" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/><ui:ToggleSwitch x:Name="StartAtSignIn" AutomationProperties.Name="Start at Windows sign-in"/></StackPanel></Grid>
      <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CONTROLS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ui:TextBox x:Name="Shortcut" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="ShortcutKey" ToolTip="Shortcut: select this field and press your preferred keys" AutomationProperties.Name="Shortcut"/></Grid>
      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Copy to clipboard" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="AutoCopy" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Double Esc to stop" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="DoubleEscape" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="RECORDINGS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ui:TextBox x:Name="Folder" Grid.Column="1" Margin="0,0,6,0" AutomationProperties.Name="Save folder" ToolTip="Save folder"/><ui:Button Grid.Column="2" Content="Browse" Click="BrowseClick" Height="34" FontSize="12" Padding="4,0"/></Grid>
      <Grid Margin="0,6,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Split recordings over 29 MB" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="SplitAt29Mb" HorizontalAlignment="Right" AutomationProperties.Name="Split recordings over 29 MB"/></Grid>
      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Highlight clicks" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="Clicks" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Keyboard events in timeline" Style="{StaticResource FieldLabel}"/><ui:ToggleSwitch Grid.Column="1" x:Name="KeyboardTimeline" HorizontalAlignment="Right" AutomationProperties.Name="Keyboard events in timeline"/></Grid>
      <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="COMPRESSION" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/><ComboBox x:Name="Compression" Grid.Column="1" Padding="10,7" AutomationProperties.Name="Compression"><ComboBoxItem Content="Original — sharper image"/><ComboBoxItem Content="Compact — smaller file"/></ComboBox></Grid>
      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="FPS" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/><ui:NumberBox x:Name="Fps" Grid.Column="2" Minimum="1" Maximum="30" SpinButtonPlacementMode="Hidden" Padding="8,7" AutomationProperties.Name="Frames per second"/><TextBlock Grid.Column="3" Text="Canvas" Style="{StaticResource FieldLabel}" Margin="8,0,8,0"/><ComboBox x:Name="Canvas" Grid.Column="4" Padding="4,7" FontSize="12" AutomationProperties.Name="Window canvas"><ComboBoxItem Content="Windows size"/><ComboBoxItem Content="Monitor size"/></ComboBox></Grid>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid x:Name="HomeFooter"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ui:Button x:Name="OpenFile" Content="Open" Click="OpenClick" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,6,0"/>
     <ui:Button Grid.Column="1" Content="Open Folder" Click="FolderClick" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,6,0"/>
     <ui:Button x:Name="CopyFile" Grid.Column="2" Content="Copy Clipboard" Click="CopyClick" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,6,0"/>
     <ui:Button x:Name="Cleanup" Grid.Column="3" Content="Clean-up" Click="CleanupClick" Foreground="#B42318" HorizontalAlignment="Stretch" Height="34" FontSize="12" Padding="4,0" Margin="0,0,6,0"/>
     <ui:Button Grid.Row="1" Grid.Column="3" Content="Quit" Click="QuitClick" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="34" FontSize="12" Padding="4,0" Margin="0,0,6,0"/>
    </Grid>
    <StackPanel x:Name="SettingsFooter" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"><ui:Button Content="Cancel" Click="CancelSettingsClick" Width="96" Height="34" FontSize="12" Padding="4,0" Margin="0,0,8,0"/><ui:Button Content="Save" Appearance="Primary" Click="SaveClick" Width="96" Height="34" FontSize="12" Padding="4,0"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</ui:FluentWindow>
