<ui:FluentWindow x:Class="Gaze.Fluent.TranscribeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Gaze · Screenshot" Width="332.35" Height="540" MinWidth="0" MinHeight="0" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="True" Topmost="True" WindowStartupLocation="Manual" Style="{DynamicResource DefaultFluentWindowStyle}">
 <ui:FluentWindow.Template><ControlTemplate TargetType="{x:Type ui:FluentWindow}"><AdornerDecorator><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></AdornerDecorator></ControlTemplate></ui:FluentWindow.Template>
 <ui:FluentWindow.Resources>
  <Style x:Key="FinishButtonStyle" TargetType="Button">
   <Setter Property="Background" Value="#B50F21"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#B50F21"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="Background" Value="#960C1B"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFrame" Property="Background" Value="#780A16"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </ui:FluentWindow.Resources>
 <Border Width="391" Height="635.2941176" Background="#F7F9FC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12">
  <Border.LayoutTransform><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Border.LayoutTransform>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Border Background="#12080B" CornerRadius="12,12,0,0"/>
    <Image Source="Assets/gaze-header.png" Stretch="Uniform" VerticalAlignment="Top" MouseLeftButtonDown="HeaderDrag" AutomationProperties.Name="Gaze — Into the abyss"/>
    <ui:Button x:Name="CloseButton" Content="×" ToolTip="Close session" AutomationProperties.Name="Close session" Click="CloseClick" Width="30" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Background="#210E13" BorderBrush="#63202D" Foreground="#ECDADF"/>
   </Grid>
   <Grid Grid.Row="1" Margin="11.7647,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Screenshot" FontSize="20" FontWeight="SemiBold" Foreground="#101828"/>
    <TextBlock x:Name="TriggerHelp" Grid.Row="1" Text="Middle-click a window, or middle-drag an area.&#10;Screenshots copy as a batch. ZIP packages this batch." TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,12"/>
    <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="8">
     <Grid><TextBlock x:Name="Empty" Text="No captures yet" Foreground="#98A2B3" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Thumbnail" Stretch="Uniform" AutomationProperties.Name="Latest capture"/></Grid>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="CountText" Text="0 captures" FontWeight="SemiBold" Foreground="#344054"/><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#667085"/></ScrollViewer></StackPanel>
   </Grid>
   <StackPanel Grid.Row="2" Margin="11.7647,0,11.7647,12"><ui:Button x:Name="RetryButton" Content="Retry clipboard" AutomationProperties.Name="Retry clipboard" Click="RetryClick" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ui:Button x:Name="UndoButton" Content="Undo" AutomationProperties.Name="Undo latest capture" Click="UndoClick" HorizontalAlignment="Stretch" Margin="0,0,6,0"/>
    <Button x:Name="DoneButton" Style="{StaticResource FinishButtonStyle}" Grid.Column="1" Content="ZIP" AutomationProperties.Name="ZIP current batch" Click="DoneClick" HorizontalAlignment="Stretch" Margin="0,0,6,0" Background="#B50F21" Foreground="White"/>
    <ui:Button x:Name="NextButton" Grid.Column="2" Content="Next Batch" AutomationProperties.Name="Next Batch" Click="NextClick" HorizontalAlignment="Stretch"/>
   </Grid></StackPanel>
  </Grid>
 </Border>
</ui:FluentWindow>
